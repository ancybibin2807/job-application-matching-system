# ─── Database ─────────────────────────────────────────────────────────────────
# For docker-compose (Postgres). For local SQLite dev, set DATABASE_URL only.
POSTGRES_USER=jobuser
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD
POSTGRES_DB=job_matching_db

# Local SQLite (dev only) — uncomment to use instead of Postgres
# DATABASE_URL=sqlite:///./job_matching.db

# ─── JWT ──────────────────────────────────────────────────────────────────────
# REQUIRED. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# The backend will REFUSE to start if this is empty or a known weak default.
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── CORS / Cookies ───────────────────────────────────────────────────────────
# Comma-separated explicit origins. Wildcards + credentials is a misconfig.
FRONTEND_ORIGINS=http://localhost:3000

# In production behind HTTPS, set COOKIE_SECURE=true.
# If frontend and API are on DIFFERENT origins, set COOKIE_SAMESITE=none AND COOKIE_SECURE=true.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ─── Frontend ─────────────────────────────────────────────────────────────────
REACT_APP_API_URL=http://localhost:8000
